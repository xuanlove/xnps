APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# 相对资源路径，避免反向代理 / 多域名访问时 @vite 生成跨域绝对 URL
ASSET_URL=/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# 队列可见性超时（秒）：必须大于最长 Job 运行时间（升级 Job 可达数十分钟）
# 使用 database 队列时改 DB_QUEUE_RETRY_AFTER，redis 队列时改 REDIS_QUEUE_RETRY_AFTER
DB_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- 支付渠道（支付宝 / 微信支付 v3）----
PAYMENT_DEFAULT_CHANNEL=mock
PAYMENT_MOCK_ENABLED=true
PAYMENT_EXPIRE_MINUTES=30

ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=

WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
WECHAT_PAY_NOTIFY_URL=

# ---- 证书 ACME 来源：certd | builtin（空=仅人工上传）----
# 敏感写操作（/ext/cert、/ext/config、/ext/upgrade、/ext/restart）强制 HTTPS
NPS_REQUIRE_HTTPS=false
NPS_ACME_MODE=
NPS_ACME_EMAIL=
# 空=Let's Encrypt 生产；测试可用 https://acme-staging-v02.api.letsencrypt.org/directory
NPS_ACME_DIRECTORY_URL=
NPS_ACME_CERTD_URL=
NPS_ACME_CERTD_TOKEN=

# certd 部署通道（空=自动回退 native 直推 /ext/cert）
NPS_CERTD_DEPLOY_URL=
NPS_CERTD_TOKEN=
# 告警 webhook（空=仅落库+日志）
NPS_ALERT_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
