# syntax=docker/dockerfile:1
#
# xnps 服务端镜像（I3）：Go 1.26 静态编译 + alpine 运行时（保留 CA/TZ）。
# conf 与 web 资源随镜像提供，生产建议挂载 conf 目录持久化。

FROM golang:1.26-alpine AS builder
ARG GOPROXY=https://proxy.golang.org,direct
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/xnps ./cmd/nps/nps.go

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /
COPY --from=builder /out/xnps /xnps
COPY conf /conf
COPY web /web
COPY deploy/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh
VOLUME /conf
EXPOSE 8080 8024 80 443
ENTRYPOINT ["/docker-entrypoint.sh"]
