{
  "title": "xnps 运维面板",
  "uid": "xnps-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "同步延迟（秒，-1=从未同步）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": -1, "custom": { "thresholdsStyle": { "mode": "line" } } },
        "overrides": []
      },
      "targets": [
        { "expr": "max by (server) (nps_sync_lag_seconds)", "legendFormat": "{{server}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "队列积压",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "sum by (queue) (nps_queue_jobs)", "legendFormat": "{{queue}}" },
        { "expr": "nps_queue_failed_jobs_total", "legendFormat": "failed" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "nps API 错误率（最近窗口）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "expr": "nps_api_error_ratio", "legendFormat": "{{window}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "计费结算耗时（秒，最近 24h）",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "nps_billing_settle_duration_seconds", "legendFormat": "{{stat}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "升级 Run 状态",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "nps_upgrade_runs", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "未解决告警",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(nps_alerts_open)", "legendFormat": "open" }
      ]
    }
  ]
}
